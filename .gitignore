# Large data and the local database.
# Download the raw CSV from Kaggle; everything else is generated by notebook 01.
# The folders are kept (via .gitkeep) so the notebooks have somewhere to write.
data/raw/*
data/corrupted/*
data/quarantine/*
db/*
!data/raw/.gitkeep
!data/corrupted/.gitkeep
!data/quarantine/.gitkeep
!db/.gitkeep

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# AI assistant files (local context and settings)
.claude/
AGENTS.md
CLAUDE.md

# OS files
.DS_Store
Thumbs.db
